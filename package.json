{
  "name": "wallsoul",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run characters && tsc && vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "tauri": "tauri",
    "characters": "node --import tsx scripts/check-characters.ts",
    "preview": "vite preview --host 127.0.0.1 --port 1420 --strictPort",
    "build:desktop": "npm run characters:bundle && tsc && vite build --mode desktop",
    "characters:bundle": "node --import tsx scripts/stage-characters.ts"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "@tauri-apps/api": "^2.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "vite": "^7.3.7"
  }
}
